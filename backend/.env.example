# Porta do Servidor Backend
PORT=3001
FRONTEND_URL=http://localhost:3000

# Configuração de Banco de Dados Relacional (TypeORM)
# Opções suportadas para DB_TYPE: "sqljs" (SQLite Relacional local sem precisar de servidor externo), "postgres" ou "mysql"
DB_TYPE=sqljs
DB_SQLITE_PATH=./data/ecommerce.sqlite

# Caso utilize PostgreSQL ou MySQL (ex: via docker-compose up -d):
# DB_TYPE=postgres
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=desafio_ecommerce

# Configuração de E-mail (Nodemailer)
# Se deixado em branco, o sistema cria automaticamente uma caixa de entrada real de teste no Ethereal SMTP
# e retorna o link de visualização (Preview URL) do e-mail enviado no retorno da compra!
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NovaStore E-commerce <no-reply@novastore.dev>"

